{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PORT=4001", "node", "backend/src/server.js"],
      "port": 4001,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "env",
      "runtimeArgs": ["VITE_API_URL=http://localhost:4001", "npm", "--prefix", "frontend", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "port": 5174,
      "autoPort": false
    }
  ]
}
